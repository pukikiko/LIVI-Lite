// Design tokens ported from the original LIVI renderer:
// src/renderer/src/theme/theme.ts + themeColors.ts.
//
// Colors are derived from App.dark-mode so the light/dark setting keeps working.

import "fonts/Roboto-Regular.ttf";
import "fonts/Roboto-Medium.ttf";
import "fonts/Roboto-Bold.ttf";
import { App } from "common.slint";

export global Theme {
    out property <bool> dark: App.dark-mode;

    // Backgrounds. `card` is the MUI Paper surface (5% white over black in dark).
    out property <color> background: dark ? App.theme-background-dark : App.theme-background-light;
    out property <color> card: dark ? #0d0d0d : #dedede;

    // Text colors.
    out property <color> text-primary: dark ? #ffffff : #000000;
    out property <color> text-secondary: dark ? #bbbbbb : #333333;
    out property <color> text-disabled: dark ? #7a7a7a : #9e9e9e;
    // Idle nav-rail tabs, like MUI's unselected Tab glyphs.
    out property <color> nav-idle: dark ? #999999 : #666666;

    // Highlight (primary) colors, overridable in Settings > Appearance.
    out property <color> primary: dark ? App.theme-primary-dark : App.theme-primary-light;
    out property <color> highlight: dark ? App.theme-highlight-dark : App.theme-highlight-light;
    out property <color> success: #30fb37;

    // Divider colors.
    out property <color> divider: dark ? #444444 : #cccccc;

    // Artwork / inset surfaces.
    out property <color> artwork-surface: dark ? #ffffff0f : #0000000f;
    out property <color> artwork-border: dark ? #ffffff0f : #00000014;

    // Soft alpha fills used by the original theme.
    out property <color> rail-track: dark ? #ffffff42 : #00000042;
    out property <color> control-surface: #ffffff29;
    out property <color> control-surface-active: #ffffff3d;
    out property <color> switch-off: dark ? #ffffff4d : #00000040;
    out property <color> state-hover: #61dafb1a;

    out property <string> font-family: "Roboto";

    // Metrics (720p reference, matching the renderer's clamps).
    out property <length> nav-rail-width: 90px;
    out property <length> nav-icon-size: 32px;
    out property <length> row-icon-size: 24px;
    out property <length> row-pad: 14px;
    out property <length> row-gap: 16px;
    out property <length> row-height: 52px;
    out property <length> card-radius: 10px;

    out property <length> title-size: 26px;
    out property <length> row-font-size: 16px;
    out property <length> value-font-size: 15px;
}
