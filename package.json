{
  "name": "LIVI",
  "version": "9.3.0",
  "description": "LIVI-Lite - native CarPlay & Android Auto head unit (no Electron)",
  "author": "Lasse Heitgres",
  "contributors": [
    "Anton Ashyn",
    "Lasse Heitgres"
  ],
  "homepage": "https://f-io.dev",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "lint:check": "biome lint .",
    "build:ui": "cargo build --release --manifest-path native/livi-ui/Cargo.toml",
    "build:native": "node scripts/build-native.mjs",
    "build:native:arm64": "node scripts/build-native.mjs --arch=arm64",
    "build:native:x64": "node scripts/build-native.mjs --arch=x64",
    "build": "pnpm run build:native",
    "start": "native/livi-helperd/build/Release/livi-core",
    "start:headless": "LIVI_NO_UI=1 native/livi-helperd/build/Release/livi-core"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,json,jsonc,css,scss,md,yml,yaml}": "biome check --write --no-errors-on-unmatched",
    "*.rs": "rustfmt"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
